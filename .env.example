# Semicolon-separated absolute folders. JARVIS rejects filesystem access elsewhere.
JARVIS_ALLOWED_ROOTS=%USERPROFILE%\Documents\JarvisWorkspace

# Comma-separated origins. Exact origin or subdomain matches only.
JARVIS_ALLOWED_ORIGINS=https://github.com,https://www.google.com,https://business.facebook.com,https://admin.shopify.com

# Voice is opt-in and off until basic automation is reliable.
VITE_ENABLE_VOICE=false

# Optional alternative to entering the key in Settings. Never commit the real key.
# OPENAI_API_KEY=sk-...

